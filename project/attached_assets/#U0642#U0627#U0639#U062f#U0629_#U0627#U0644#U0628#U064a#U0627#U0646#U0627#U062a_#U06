
الكود  االاستعلم

-- استعلام موحد لجمع كل معلومات نظام الدردشة (بدون جداول غير موجودة)
WITH 
-- 1) معلومات أعمدة جداول الدردشة
columns_info AS (
  SELECT 
    table_name,
    json_agg(json_build_object(
      'column', column_name,
      'type', data_type,
      'nullable', is_nullable,
      'default', column_default
    ) ORDER BY ordinal_position) AS columns
  FROM information_schema.columns
  WHERE table_schema = 'public'
    AND table_name IN (
      'product_chat', 'service_chat',
      'profiles', 'sellers', 'service_providers',
      'notifications'
    )
  GROUP BY table_name
),

-- 2) المفاتيح الخارجية لجداول الدردشة
foreign_keys AS (
  SELECT 
    tc.table_name,
    json_agg(json_build_object(
      'column', kcu.column_name,
      'foreign_table', ccu.table_name,
      'foreign_column', ccu.column_name
    )) AS foreign_keys
  FROM information_schema.table_constraints tc
  JOIN information_schema.key_column_usage kcu
    ON tc.constraint_name = kcu.constraint_name
  JOIN information_schema.constraint_column_usage ccu
    ON tc.constraint_name = ccu.constraint_name
  WHERE tc.constraint_type = 'FOREIGN KEY'
    AND tc.table_schema = 'public'
    AND tc.table_name IN ('product_chat', 'service_chat')
  GROUP BY tc.table_name
),

-- 3) سياسات RLS لجداول الدردشة
rls_policies AS (
  SELECT 
    tablename,
    json_agg(json_build_object(
      'policy', policyname,
      'command', cmd,
      'roles', roles,
      'using', qual,
      'with_check', with_check
    )) AS policies
  FROM pg_policies
  WHERE tablename IN ('product_chat', 'service_chat')
  GROUP BY tablename
),

-- 4) Triggers الخاصة بالدردشة والإشعارات
triggers_info AS (
  SELECT 
    event_object_table AS table_name,
    json_agg(json_build_object(
      'trigger', trigger_name,
      'timing', action_timing,
      'event', event_manipulation,
      'statement', action_statement
    )) AS triggers
  FROM information_schema.triggers
  WHERE event_object_table IN ('product_chat', 'service_chat', 'notifications')
  GROUP BY event_object_table
),

-- 5) حالة RLS
rls_status AS (
  SELECT 
    relname AS table_name,
    relrowsecurity AS rls_enabled,
    relforcerowsecurity AS rls_forced
  FROM pg_class
  WHERE relname IN ('product_chat', 'service_chat')
),

-- 6) معلومات إضافية: عدد الرسائل لكل دردشة (مع التحقق من وجود الجداول)
message_stats AS (
  SELECT 
    'product_chat' AS table_name,
    COALESCE(
      (SELECT json_agg(json_build_object(
        'chat_id', id,
        'message_count', 0  -- يمكن تعديل هذا إذا وجد جدول الإعجابات
      )) FROM product_chat),
      '[]'::json
    ) AS stats
  UNION ALL
  SELECT 
    'service_chat' AS table_name,
    COALESCE(
      (SELECT json_agg(json_build_object(
        'chat_id', id,
        'message_count', 0  -- يمكن تعديل هذا إذا وجد جدول الإعجابات
      )) FROM service_chat),
      '[]'::json
    ) AS stats
)

-- النتيجة النهائية الموحدة لنظام الدردشة
SELECT 
  COALESCE(c.table_name, f.table_name, p.tablename, t.table_name, r.table_name, s.table_name) AS "اسم_الجدول",
  c.columns AS "الأعمدة",
  f.foreign_keys AS "المفاتيح_الخارجية",
  p.policies AS "سياسات_RLS",
  t.triggers AS "المشغلات",
  r.rls_enabled AS "تفعيل_RLS",
  r.rls_forced AS "强制_RLS",
  s.stats AS "إحصائيات_المحادثات"
FROM columns_info c
FULL OUTER JOIN foreign_keys f ON c.table_name = f.table_name
FULL OUTER JOIN rls_policies p ON COALESCE(c.table_name, f.table_name) = p.tablename
FULL OUTER JOIN triggers_info t ON COALESCE(c.table_name, f.table_name, p.tablename) = t.table_name
FULL OUTER JOIN rls_status r ON COALESCE(c.table_name, f.table_name, p.tablename, t.table_name) = r.table_name
FULL OUTER JOIN message_stats s ON COALESCE(c.table_name, f.table_name, p.tablename, t.table_name, r.table_name) = s.table_name
WHERE COALESCE(c.table_name, f.table_name, p.tablename, t.table_name, r.table_name, s.table_name) IS NOT NULL
ORDER BY "اسم_الجدول";






